// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id
  first_name String
  last_name  String
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now()) @map("created_at")

  trainings Training[]
  sessions  WorkoutSession[]
  exercises Exercise[]
}

/// Catálogo de exercícios. `userId` nulo = exercício global vindo do seed;
/// preenchido = exercício personalizado criado pelo usuário.
model Exercise {
  id          String  @id @default(cuid())
  name        String
  muscleGroup String
  equipment   String?
  /// iniciante | intermediario | avancado
  level       String  @default("iniciante")
  /// Se o exercício é executado com carga externa. Falso para peso corporal
  /// e cardio: nesses, carga não é zero, é "não se aplica" — a variante com
  /// peso é outro item do catálogo (agachamento livre vs. agachamento com barra).
  /// Governa o campo de carga nos formulários e quem entra na progressão de peso.
  usesLoad    Boolean @default(true)
  /// Em que unidade o exercicio e medido: "reps" ou "duration".
  /// Nao da para deduzir do grupo muscular — burpee e cardio mas conta
  /// repeticao, e prancha e core mas conta tempo.
  tracking    String  @default("reps")
  /// Se faz sentido registrar distancia (esteira, bike, eliptico, remo).
  /// Corda naval e prancha tem duracao mas nao tem distancia.
  usesDistance Boolean @default(false)
  /// Como executar, em uma ou duas frases.
  description String?
  /// Musculos efetivamente trabalhados, do principal para os auxiliares.
  /// Mais especifico que muscleGroup, que e so a gaveta do catalogo.
  muscles     String[]
  userId      String?
  user        User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  trainingExercises TrainingExercise[]
  setLogs           SetLog[]

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([name, userId])
  @@index([muscleGroup])
}

/// A ficha de um dia da semana.
model Training {
  id          String @id @default(cuid())
  label       String
  trainingDay String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  exercises TrainingExercise[]
  sessions  WorkoutSession[]

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, trainingDay])
  @@index([userId])
}

/// Prescrição: o que a ficha manda fazer. Uniforme entre as séries —
/// a variação real de cada série fica em SetLog.
model TrainingExercise {
  id           String   @id @default(cuid())
  trainingId   String
  training     Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  order        Int
  sets         Int
  /// Preenchido quando tracking = "reps"; nulo quando e por duracao.
  reps         Int?
  /// Preenchido quando tracking = "duration". Segundos, para cobrir tanto
  /// prancha de 45s quanto esteira de 30min sem casa decimal.
  durationSeconds Int?
  targetWeight Float?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now()) @map("created_at")

  @@index([trainingId])
  @@index([exerciseId])
}

/// Uma sessão de treino realizada.
/// `trainingId` é opcional com SetNull e `trainingLabel` guarda um snapshot do nome:
/// assim, apagar a ficha não apaga meses de histórico de execução.
model WorkoutSession {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingId    String?
  training      Training? @relation(fields: [trainingId], references: [id], onDelete: SetNull)
  trainingLabel String
  performedAt   DateTime  @default(now())
  notes         String?

  setLogs SetLog[]

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, performedAt])
  @@index([trainingId])
}

/// Execução: uma linha por série efetivamente realizada.
/// Aponta para o catálogo (Exercise), nunca para TrainingExercise — é isso que
/// mantém o histórico intacto quando a ficha é editada.
model SetLog {
  id         String         @id @default(cuid())
  sessionId  String
  session    WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  setNumber  Int
  /// Exatamente um destes vem preenchido, conforme Exercise.tracking
  reps       Int?
  durationSeconds Int?
  /// Quilometros, so para exercicio com usesDistance
  distanceKm Float?
  /// kg; 0 para exercícios de peso corporal
  weight     Float
  /// esforço percebido, 1 a 10
  rpe        Int?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@index([exerciseId])
}
